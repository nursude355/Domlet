{
  "version": "0.2.0",
  "configurations": [

    {
      "name": "Debug slint-dom-macros single test",
      "type": "lldb",
      "request": "launch",
      "sourceLanguages": ["rust"],
      "cargo": {
        "args": [
          "test",
          "-p",
          "slint-dom-macros",
          "--lib",
          "generate::tests::rejects_unsupported_elements"
        ]
      },
      "cwd": "${workspaceFolder}"
    }
  ]
}
